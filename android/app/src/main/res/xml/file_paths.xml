<?xml version="1.0" encoding="utf-8"?>
<!--
  应用内更新：把下载到私有目录的 APK 通过 content:// 交给系统安装器。

  只开放 apk 一类扩展名、且只给 cache 目录下的 update_*.apk 用，
  不做成任意路径可读——否则等于把应用私有文件全暴露给任何能发
  ACTION_VIEW 的应用。
-->
<paths>
    <!-- 下载的更新包落在 getTemporaryDirectory()，对应 cache 目录 -->
    <cache-path name="updates" path="." />
</paths>
