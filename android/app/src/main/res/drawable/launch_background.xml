<?xml version="1.0" encoding="utf-8"?>
<!--
  启动背景：纯黑，与 App 的 canvas 一致。

  默认模板这里是 `@android:color/white`，配合 values/styles.xml 的
  Theme.Light，会在启动瞬间闪一下白屏。本 App 界面是纯黑设计，
  启动窗口跟着黑，用户感知不到"启动"这件事。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
</layer-list>
