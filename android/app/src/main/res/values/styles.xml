<?xml version="1.0" encoding="utf-8"?>
<!--
  启动主题：**始终用暗色**。

  为什么不能用默认的 Theme.Light：
  本 App 的界面是纯黑设计（R34Color.canvas = #000000）。而 Flutter 的默认
  模板在 `values/` 里给了 `Theme.Light.NoTitleBar` + 白色 windowBackground，
  只在系统开了深色模式时才走 `values-night/` 的黑色版本。

  结果是：**用户没开系统深色模式时，启动瞬间是刺眼的白屏，紧接着 Flutter
  第一帧变成纯黑加载页** —— 一次明显的黑白闪烁。真机上看起来像闪了一下。

  这里的界面强制暗色，所以启动窗口也必须暗色，跟系统设置无关。
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
