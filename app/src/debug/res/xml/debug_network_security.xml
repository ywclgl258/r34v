<network-security-config>
    <!-- 与主配置一致：Android 7.0 缺 ISRG Root X1，媒体 CDN（Let's Encrypt）需要补充根。 -->
    <base-config cleartextTrafficPermitted="false"><trust-anchors><certificates src="system" /><certificates src="@raw/isrg_root_x1" /></trust-anchors></base-config>
    <domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="false">localhost</domain><domain includeSubdomains="false">127.0.0.1</domain></domain-config>
</network-security-config>
